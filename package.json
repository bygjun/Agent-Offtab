    "demo": "node build/demo.mjs"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "24",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.79.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@tauri-apps/plugin-notification": "2.8.1"
  }
}
